# URL Shortener - Environment Variables Configuration
# Copy this file to .env and update with your actual values

# ============================================
# Application Configuration
# ============================================
APP_NAME=URL Shortener
APP_VERSION=1.0.0
ENVIRONMENT=development
BASE_URL=http://localhost:8080

# ============================================
# MongoDB Configuration
# ============================================
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_DATABASE=urlshortener
MONGODB_URI=mongodb://localhost:27017/urlshortener

# ============================================
# Kafka Configuration
# ============================================
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_BROKER_ID=1
KAFKA_ZOOKEEPER_CONNECT=localhost:2181
KAFKA_AUTO_CREATE_TOPICS_ENABLE=true
KAFKA_CONSUMER_GROUP=url-shortener-consumer-group

# ============================================
# Elasticsearch Configuration
# ============================================
ELASTICSEARCH_URIS=http://localhost:9200
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_REQUEST_TIMEOUT=5000
ELASTICSEARCH_INDEX_NAME=url-shortner-logs

# ============================================
# Vault Configuration
# ============================================
VAULT_ENABLED=false
VAULT_HOST=localhost
VAULT_PORT=8200
VAULT_TOKEN=dev-root-token
VAULT_SCHEME=http
VAULT_NAMESPACE=
VAULT_AUTHENTICATION=token

# ============================================
# Spring Cloud Configuration
# ============================================
SPRING_CONFIG_IMPORT=optional:configserver:http://localhost:8888
SPRING_APPLICATION_NAME=url-shortener
SPRING_PROFILES_ACTIVE=dev

# ============================================
# Eureka Configuration
# ============================================
EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://localhost:8761/eureka/
EUREKA_INSTANCE_HOSTNAME=localhost
EUREKA_INSTANCE_PREFER_IP_ADDRESS=true
EUREKA_CLIENT_REGISTER_WITH_EUREKA=true
EUREKA_CLIENT_FETCH_REGISTRY=true

# ============================================
# Service Ports
# ============================================
CONFIG_SERVER_PORT=8888
DISCOVERY_SERVER_PORT=8761
API_GATEWAY_PORT=8080
URL_SERVICE_PORT=8081
ANALYTICS_SERVICE_PORT=8082
FRONTEND_PORT=80

# ============================================
# Distributed Tracing (Zipkin)
# ============================================
MANAGEMENT_ZIPKIN_TRACING_ENDPOINT=http://localhost:9411/api/v2/spans
MANAGEMENT_TRACING_SAMPLING_PROBABILITY=1.0

# ============================================
# Logging Configuration
# ============================================
LOGGING_LEVEL=INFO
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK=INFO
LOGGING_LEVEL_ORG_RAM=DEBUG
LOGBACK_INCLUDE=default
LOG_FILE=/var/log/url-shortener/application.log

# ============================================
# Database Configuration (Future Use)
# ============================================
DATABASE_URL=jdbc:mysql://localhost:3306/url_shortener
DATABASE_USERNAME=root
DATABASE_PASSWORD=password
DATABASE_DRIVER_CLASS=com.mysql.cj.jdbc.Driver

# ============================================
# JWT Configuration
# ============================================
JWT_SECRET=url-shortner-jwt-secret-key-2024-development-only
JWT_EXPIRATION=86400
JWT_REFRESH_EXPIRATION=604800

# ============================================
# Security Configuration
# ============================================
SECURITY_CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:4200,http://localhost:80
SECURITY_CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
SECURITY_CORS_ALLOWED_HEADERS=*
SECURITY_CORS_ALLOW_CREDENTIALS=true

# ============================================
# Rate Limiting Configuration
# ============================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW_SECONDS=60

# ============================================
# API Configuration
# ============================================
API_URL_SHORTENER_PREFIX=/api/v1/urls
API_ANALYTICS_PREFIX=/api/v1/analytics
API_HEALTH_PREFIX=/actuator/health

# ============================================
# Development Configuration
# ============================================
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_PROPERTIES_HIBERNATE_DIALECT=org.hibernate.dialect.MySQL8Dialect
DEBUG=false

# ============================================
# Docker Configuration
# ============================================
DOCKER_NETWORK=url-shortner-net
DOCKER_COMPOSE_VERSION=3.9

# ============================================
# Actuator Configuration
# ============================================
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics,prometheus
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=when-authorized
MANAGEMENT_METRICS_ENABLE_JVM=true
MANAGEMENT_METRICS_ENABLE_PROCESS=true

# ============================================
# Advanced Configuration
# ============================================
VAULT_SKIP_VERIFY=true
SERVER_SSL_ENABLED=false
SERVER_HTTP2_ENABLED=true
